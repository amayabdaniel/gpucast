{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Inference Cost per Model (USD/request, 5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "description": "Rate-based per-request cost: USD accrued per 5-minute window divided by requests served in that window. Prior query plotted gpucast_inference_cost_usd (the lifetime gauge) under the same 'USD/request' title — a cumulative value that only ever goes up, which is NOT per-request cost. The tenant label was dropped from the legend because gpucast removed per-tenant attribution at commit 25f2f7a and the label is always literal 'all'.",
      "targets": [
        {
          "expr": "rate(gpucast_inference_cost_usd_total[5m]) / rate(gpucast_inference_requests_total[5m])",
          "legendFormat": "{{ model }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "GPU Seconds per Request (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(gpucast_gpu_seconds_per_request_bucket[5m]))",
          "legendFormat": "{{ model }} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Tokens per GPU Dollar",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "gpucast_tokens_per_gpu_dollar",
          "legendFormat": "{{ model }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 10000 },
              { "color": "green", "value": 50000 }
            ]
          }
        }
      }
    },
    {
      "title": "vLLM KV Cache Usage (%)",
      "description": "Average vLLM KV-cache occupancy across models — NOT GPU compute utilization. gpucast scrapes vLLM /metrics which exposes KV cache but not SM counters. Prior title 'GPU Utilization (%)' + metric name gpu_utilization_percent misread as compute util, which cascaded into gpudab's dashboard as an inverted waste signal (low KV cache = efficient batching, was flagged as idle GPU). Threshold colours were calibrated against KV cache semantics, not utilization: >70% signals memory pressure, 40-70% is healthy load, <40% is efficient batching or low traffic (not waste).",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "avg(gpucast_vllm_kv_cache_usage_percent)",
          "legendFormat": "avg KV cache"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "Requests per Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rate(gpucast_inference_requests_total[5m])",
          "legendFormat": "{{ model }} ({{ status }})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        }
      }
    },
    {
      "title": "Time to First Token (p50 / p95 / p99)",
      "description": "Each series reads vLLM's own TTFT percentile aggregate directly. Prior version used histogram_quantile(X, rate(gpucast_time_to_first_token_seconds_bucket[5m])) with X = 0.5 / 0.95 / 0.99 — but the backing histogram was fed only vLLM's P50 scalar once per scrape, so all three series returned approximately the same value (~P50) while claiming three different percentiles. The three gauges below are what vLLM already measured, no histogram arithmetic in between.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "gpucast_ttft_p50_seconds",
          "legendFormat": "p50"
        },
        {
          "expr": "gpucast_ttft_p95_seconds",
          "legendFormat": "p95"
        },
        {
          "expr": "gpucast_ttft_p99_seconds",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Tokens Processed (prompt vs completion)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(gpucast_tokens_processed_total{direction=\"prompt\"}[5m])",
          "legendFormat": "prompt {{ model }}"
        },
        {
          "expr": "rate(gpucast_tokens_processed_total{direction=\"completion\"}[5m])",
          "legendFormat": "completion {{ model }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["gpucast", "inference", "gpu", "cost", "ai"],
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "query": "label_values(gpucast_inference_requests_total, model)",
        "multi": true,
        "includeAll": true
      },
      {
        "name": "tenant",
        "type": "query",
        "query": "label_values(gpucast_inference_requests_total, tenant)",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "gpucast — Inference Cost & Performance",
  "uid": "gpucast-inference-costs"
}
